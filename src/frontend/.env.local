NEXTAUTH_SECRET=unaclavesecretabuenaParagenerarTokens1234
NEXT_PUBLIC_API_URL=http://localhost:5001
NEXT_PUBLIC_WSS_URL=ws://localhost:5001

# Session timeout settings (values in milliseconds)
# Warning modal appears after this time (default: 5000ms = 5 seconds)
NEXT_PUBLIC_SESSION_WARNING_TIMEOUT=562200000
# Session expires and logout modal appears after this time (default: 10000ms = 10 seconds)
NEXT_PUBLIC_SESSION_EXPIRY_TIMEOUT=604800000

# For production, you might want to set longer timeouts, e.g.:
# NEXT_PUBLIC_SESSION_WARNING_TIMEOUT=1740000    # 29 minutes
# NEXT_PUBLIC_SESSION_EXPIRY_TIMEOUT=1800000     # 30 minutes

