{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./bin/www",
    "start:docker": "node ./bin/www",
    "dev": "cross-env NODE_ENV=development nodemon ./bin/www",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --runInBand",
    "test:setup": "node tests/verify-setup.js",
    "test:models": "cross-env NODE_ENV=test jest --runInBand tests/models/",
    "test:routes": "cross-env NODE_ENV=test jest --runInBand tests/routes/",
    "test:middleware": "cross-env NODE_ENV=test jest --runInBand tests/middleware/",
    "test:user": "cross-env NODE_ENV=test jest --runInBand tests/routes/user.test.js tests/models/User.test.js --forceExit",
    "test:silent": "cross-env NODE_ENV=test jest --runInBand --silent",
    "test:retry": "cross-env NODE_ENV=test jest --runInBand --maxWorkers=1 --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@influxdata/influxdb-client": "^1.35.0",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "http-errors": "~1.6.3",
    "jade": "^0.29.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.2",
    "morgan": "~1.9.1",
    "mqtt": "^5.10.1",
    "node-cache": "^5.1.2",
    "pg": "^8.14.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^9.1.6"
  }
}
